{
    "name": "scroogybank/scroogybank",
    "description": "Personal finance management system.",
    "keywords": [
        "finance",
        "management",
        "financial",
        "money",
        "budget",
        "bills",
        "administration",
        "personal finance",
        "laravel",
        "framework"
    ],
    "type": "project",
    "license": "MIT",
    "readme": "README.md",
    "authors": [
        {
            "name": "Dario Vogogna",
            "email": "stein.dario@gmail.com",
            "role": "developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "akaunting/laravel-money": "^5.2.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^11.35",
        "laravel/pennant": "^1.13",
        "laravel/pulse": "^1.3",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "livewire/livewire": "^3.5.17",
        "livewire/volt": "^1.6.6",
        "spatie/laravel-ignition": "^2.9",
        "spatie/laravel-permission": "^6.10.1",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14.9",
        "barryvdh/laravel-ide-helper": "^3.2.2",
        "ergebnis/phpstan-rules": "^2.5",
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.65",
        "larastan/larastan": "^2.9.12",
        "laravel/breeze": "^2.2.6",
        "laravel/pint": "^1.18.3",
        "laravel/sail": "^1.39.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.5",
        "phpstan/phpstan": "^1.12.12",
        "phpstan/phpstan-deprecation-rules": "^1.2.1",
        "phpstan/phpstan-strict-rules": "^1.6.1",
        "phpunit/php-code-coverage": "^11.0.7",
        "phpunit/phpunit": "^11.5.0",
        "squizlabs/php_codesniffer": "^3.11.1",
        "thecodingmachine/phpstan-strict-rules": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:ci": "pint --test --format=junit > test-reports/lint.xml",
        "lint:fix": "pint",
        "stan": "phpstan analyse --memory-limit=2G",
        "stan:ci": "phpstan analyse --memory-limit=2G --no-ansi --error-format=junit > test-reports/stan.xml",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
